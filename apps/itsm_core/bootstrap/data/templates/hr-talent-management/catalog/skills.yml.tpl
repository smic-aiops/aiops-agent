# skills.yml
# スキル辞書（例）
#
# - skill_id: 一意キー（英数/underscore 推奨）
# - name: 表示名
# - category: 分類（例: language, framework, infra, process）
# - levels: レベル定義（1..n）

skills:
  - skill_id: python
    name: Python
    category: language
    levels:
      - level: "1"
        description: 基礎（読める/書ける）
      - level: "2"
        description: 実務（小規模タスクを自走）
      - level: "3"
        description: 主担当（設計・レビュー可能）

