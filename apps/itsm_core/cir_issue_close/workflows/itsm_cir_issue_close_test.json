      "parameters": {
        "jsCode": "const env = $env || {};\n\nconst missing = [];\nif (!String(env.N8N_GITLAB_API_BASE_URL || env.GITLAB_API_BASE_URL || env.N8N_GITLAB_BASE_URL || env.GITLAB_BASE_URL || '').trim()) missing.push('GITLAB_API_BASE_URL');\nif (!String(env.N8N_GITLAB_TOKEN || env.GITLAB_TOKEN || env.GITLAB_ADMIN_TOKEN || '').trim()) missing.push('GITLAB_TOKEN');\n\nreturn [{\n  json: {\n    ok: missing.length === 0,\n    status_code: missing.length === 0 ? 200 : 424,\n    missing,\n    tip: 'POST /webhook/itsm/cir/issues/close (dry_run=true) で計画を確認できます。'\n  }\n}];\n",
        "mode": "runOnceForAllItems"
      },
      "id": "2",
      "name": "Env Check",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
