{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://smic-aiops.local/schemas/aiops.recovery_candidates.v1.schema.json",
  "title": "AIOps ranked recovery candidates",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "selected_rank", "candidates"],
  "properties": {
    "schema_version": {
      "const": "aiops.recovery_candidates.v1"
    },
    "selected_rank": {
      "type": ["integer", "null"],
      "minimum": 1
    },
    "candidates": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "rank",
          "id",
          "title",
          "rationale",
          "risk_level",
          "risk_reasons",
          "reversible",
          "expected_minutes",
          "requires_approval",
          "workflow_id",
          "params",
          "evidence_refs"
        ],
        "properties": {
          "rank": { "type": "integer", "minimum": 1 },
          "id": { "type": "string", "minLength": 1 },
          "title": { "type": "string", "minLength": 1 },
          "rationale": { "type": "string", "minLength": 1 },
          "risk_level": { "enum": ["low", "medium", "high"] },
          "risk_reasons": {
            "type": "array",
            "minItems": 1,
            "items": { "type": "string", "minLength": 1 }
          },
          "reversible": { "type": "boolean" },
          "expected_minutes": { "type": ["integer", "null"], "minimum": 0 },
          "requires_approval": { "type": "boolean" },
          "workflow_id": { "type": ["string", "null"] },
          "params": { "type": "object" },
          "evidence_refs": {
            "type": "array",
            "items": { "type": "string", "minLength": 1 }
          }
        }
      }
    }
  }
}
